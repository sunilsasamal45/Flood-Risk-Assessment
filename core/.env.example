APP_H2OGPTE_URL=
APP_H2OGPTE_API_KEY=
APP_H2OGPTE_MODEL=
APP_NVIDIA_API_KEY=

# =============================================================================
# Twilio SMS Alert Settings
# Get credentials from https://console.twilio.com
# =============================================================================
APP_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_TWILIO_AUTH_TOKEN=your_auth_token_here
APP_TWILIO_FROM_NUMBER=+1XXXXXXXXXX
APP_SMS_ALERT_NUMBERS=["+917008553530","+919827963345"]
APP_SMS_ALERTS_ENABLED=true
APP_SMS_ALERT_MIN_SEVERITY=HIGH
APP_SMS_COOLDOWN_MINUTES=30

# =============================================================================
# PDF Report Settings
# =============================================================================
APP_REPORTS_DIR=.data/reports
APP_PDF_REPORTS_ENABLED=true
APP_AUTO_PDF_ON_CRITICAL=true